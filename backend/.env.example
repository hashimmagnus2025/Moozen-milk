# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/vrinda-dairy

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — the frontend origin allowed to call this API
CLIENT_URL=http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE_MB=5

# Used only by `npm run seed:admin` to create the first admin account
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@vrinda.com
SEED_ADMIN_PASSWORD=change-this-password
